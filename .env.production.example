# TerraFlux Production Environment Variables
# ---------------------------------------------
# Option 1: Separate API Domain / Cloud Run / Render backend URL
# VITE_API_BASE_URL=https://api.terraflux.yourdomain.com

# Option 2: Same-origin or reverse-proxy deployment (e.g., Nginx routing /api to backend)
# Leave VITE_API_BASE_URL empty so the app uses relative paths (e.g., /api/search)
VITE_API_BASE_URL=
